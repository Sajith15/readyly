# Copy to .env and fill in. Never commit the real .env.

# --- Database -------------------------------------------------------------
# Postgres connection string (Render / Neon / local Docker).
DATABASE_URL=postgresql://stash:stash@localhost:55432/stash

# --- AI co-pilot ----------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint whose model supports tool
# calling. Leave AI_BASE_URL blank to use OpenAI itself.
#
#   Gemini : https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenAI : (leave blank)
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=AIzaSy-your-key-here
AI_MODEL=gemini-2.5-flash

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Shared sandbox sender; swap for a verified domain if you have one.
EMAIL_FROM=Stash <onboarding@resend.dev>

# --- App ------------------------------------------------------------------
# Public base URL, used to build password-reset links. No trailing slash.
BASE_URL=http://localhost:8000
# Set to "production" on Render so session cookies are marked Secure.
APP_ENV=development
